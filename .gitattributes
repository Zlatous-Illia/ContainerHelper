# The repository stores everything with LF, the working copy as is customary
# on the system. The project's files ended up mixed: some CRLF, some LF.
# Without this line the difference would get into history and show up in
# every diff as an edit of the whole file.
* text=auto

# Factory measurements are data, not text for editing, but their diffs still
# have to be readable.
*.json text
